# Optional cloud product interpretation. Actual credentials belong in local .env.
LLAMA_API_KEY=
LLAMA_MODEL=
LLAMA_VISION_MODEL=

# Connected local demo; one API worker per SQLite file.
STREET_CEO_STORE=sqlite
STREET_CEO_SQLITE_PATH=data/demo-mvp.sqlite3
STREET_CEO_TRACE_DATABASE=data/muse-traces.sqlite3
STREET_CEO_SEED_DEMO=1
STREET_CEO_VOICE_ENABLED=1
STREET_CEO_LOCAL_TEAM_ENABLED=0

# Backend terminal output: off, normal, detail (sanitized request/response).
# infra/dev.py api defaults to detail unless this environment variable is set.
STREET_CEO_CONSOLE_TRACE=detail
