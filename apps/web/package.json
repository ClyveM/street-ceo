{
  "name": "street-ceo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:muse": "node --experimental-strip-types --test tests/muse.test.mjs",
    "test:frontend": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev:office": "vite --config local-office/vite.config.ts",
    "build:office": "tsc -p local-office/tsconfig.json && vite build --config local-office/vite.config.ts",
    "test:office": "node --experimental-strip-types --test local-office/tests/*.test.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2"
  }
}
